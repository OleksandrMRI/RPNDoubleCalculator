<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
    <Appenders>
        <Console name="LogToConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%highlight{%d{HH:mm:ss.SSS} [%t] %-5level  %logger{36}:%L - %msg%n}{DEBUG=yellow}" disableAnsi="false"/>
        </Console>
        <RollingFile name="LogToRollingFile" fileName="logs/app.log"
                     filePattern="logs/$${date:yyyy-MM}/app-%d{MM-dd-yyyy}-%i.log.gz" append="false">
            <PatternLayout>
                <Pattern>%d %p %c{1.} %L [%t] %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="com.shpp.p2p.cs.ohololobov.assignment10" level="debug" >
            <AppenderRef ref="LogToConsole"/>
        </Logger>
        <!--Logger name="com.shpp.p2p.cs.ohololobov.assignment7" level="debug">
            <AppenderRef ref="LogToConsole"/>
        </Logger-->
        <Root level="error" includeLocation="true">
            <!--AppenderRef ref="LogToConsole"/-->
            <AppenderRef ref="LogToRollingFile"/>
        </Root>
    </Loggers>

</Configuration>
